    "paywall.cta.reassurance.trial.monthly %@ %@" : {
      "comment" : "Full monthly free-trial conversion disclosure. The first value is the localized trial duration and the second is the localized monthly price.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, then %2$@ is charged automatically each month until canceled."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, därefter debiteras %2$@ automatiskt varje månad tills du avslutar."
          }
        }
      }
    },
    "paywall.cta.reassurance.trial.yearly %@ %@" : {
      "comment" : "Full yearly free-trial conversion disclosure. The first value is the localized trial duration and the second is the localized yearly price.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, then %2$@ is charged automatically each year until canceled."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, därefter debiteras %2$@ automatiskt varje år tills du avslutar."
          }
        }
      }
    },
    "paywall.error.entitlementNotActive" : {
      "comment" : "Error shown when a purchase completes but no active entitlement is found",
