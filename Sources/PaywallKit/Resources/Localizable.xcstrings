    "paywall.cta.reassurance.subscription" : {
      "comment" : "Reassurance line under the purchase button for subscriptions without a free trial",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancel anytime."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avsluta när du vill."
